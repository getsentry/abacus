# =============================================================================
# Abacus Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values
# Required variables are marked with [REQUIRED]

# =============================================================================
# Database [REQUIRED]
# =============================================================================

# PostgreSQL connection string (Neon serverless driver).
# For local development, create a Neon branch and use its POOLED connection string:
#   npx neonctl branches create --project-id <project-id> --name dev/<you>
#   npx neonctl connection-string dev/<you> --project-id <project-id> --pooled
POSTGRES_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=require

# =============================================================================
# Authentication [REQUIRED for web UI]
# =============================================================================

# Google OAuth credentials (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Restrict login to a specific email domain (e.g., "mycompany.com")
# Leave empty to allow any Google account
NEXT_PUBLIC_DOMAIN=

# Shared secret for the OAuth proxy (enables Google login on Vercel preview
# deployments by routing the OAuth callback through production).
# MUST be the same value in the Production and Preview Vercel environments.
# Not used for local development — register
# http://localhost:3000/api/auth/callback/google on the Google OAuth client
# and localhost logs in directly.
# Generate with: openssl rand -hex 32
OAUTH_PROXY_SECRET=

# =============================================================================
# Data Sources - Anthropic
# =============================================================================

# Anthropic Admin API key for Claude Code usage data
# Get from: https://console.anthropic.com/settings/admin-keys
ANTHROPIC_ADMIN_KEY=

# =============================================================================
# Data Sources - Cursor
# =============================================================================

# Cursor Admin API key for team usage data
# Get from: Cursor dashboard > Team Settings > API
CURSOR_ADMIN_KEY=

# =============================================================================
# Data Sources - GitHub (for commit tracking)
# =============================================================================

# Option 1: GitHub App (recommended for organizations)
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_INSTALLATION_ID=

# Option 2: Personal Access Token (simpler setup)
# GITHUB_TOKEN=

# Webhook secret for verifying GitHub webhook payloads
# GITHUB_WEBHOOK_SECRET=

# Default GitHub org for user mappings (defaults to "getsentry")
# GITHUB_ORG=

# =============================================================================
# OpenRouter Key Provisioning
# =============================================================================

# Single-workspace setup: one management key → workspace named "default"
# (create at https://openrouter.ai/settings/management-keys)
OPENROUTER_MANAGEMENT_KEY=

# Multi-workspace setup: JSON map of workspace name → management key
# Use this when you have multiple OpenRouter workspaces to track separately.
# In .env files, wrap the JSON in single quotes:
#   OPENROUTER_MANAGEMENT_KEYS='{"Coding Agents":"sk-or-v1-...","Tools":"sk-or-v1-..."}'
# In Vercel env UI, paste the raw JSON without surrounding quotes:
#   {"Coding Agents":"sk-or-v1-...","Tools":"sk-or-v1-..."}
# When both OPENROUTER_MANAGEMENT_KEY and OPENROUTER_MANAGEMENT_KEYS are set,
# OPENROUTER_MANAGEMENT_KEYS takes precedence.
# OPENROUTER_MANAGEMENT_KEYS=

# Comma-separated list of admin emails who can manage all keys
ADMIN_EMAILS=

# =============================================================================
# Google Directory (Offboarding)
# =============================================================================

# Service account key JSON (base64-encoded) for Google Admin SDK Directory API
# Used by the nightly cron to detect offboarded Workspace users and disable their keys
# Download from GCP Console > IAM > Service Accounts > Keys, then base64-encode:
#   base64 -i service-account-key.json | tr -d '\n'
GOOGLE_SA_KEY_JSON=

# Workspace admin email for domain-wide delegation (the service account impersonates this user)
# Must be a Google Workspace admin with Directory API read access
GOOGLE_DIRECTORY_SUBJECT=

# =============================================================================
# Cron Jobs (Vercel)
# =============================================================================

# Secret for authenticating Vercel cron job requests
# Generate with: openssl rand -hex 32
CRON_SECRET=

# =============================================================================
# Observability (Optional)
# =============================================================================

# Sentry DSN for error tracking
# NEXT_PUBLIC_SENTRY_DSN=
