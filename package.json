{
  "name": "abacus",
  "version": "1.0.0",
  "description": "Track and analyze AI coding tool usage across your team",
  "license": "Apache-2.0",
  "author": "Sentry",
  "repository": {
    "type": "git",
    "url": "https://github.com/getsentry/abacus.git"
  },
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/cli/index.ts db:migrate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "backfill": "tsx scripts/backfill.ts",
    "cli": "tsx scripts/cli/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@sentry/nextjs": "^10.76.2",
    "@vercel/postgres": "^0.10.0",
    "better-auth": "^1.7.10",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.4",
    "framer-motion": "^12.43.0",
    "geist": "^1.7.2",
    "lucide-react": "^0.562.0",
    "next": "16.3.8",
    "papaparse": "^5.7.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx}": "bash -c 'pnpm tsc --noEmit --skipLibCheck'"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@sentry/cli",
      "esbuild",
      "sharp",
      "simple-git-hooks"
    ]
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.9.9",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.1.1",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.4.0",
    "msw": "^2.15.0",
    "postgres": "^3.4.9",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
